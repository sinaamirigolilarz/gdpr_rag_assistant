# Copy this file to `.env` and fill in your own values. Never commit `.env`.

# ---------------------------------------------------------------------------
# Retrieval
# ---------------------------------------------------------------------------
# Local embedding model (downloaded once from Hugging Face).
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Chunking used by `build-index` and `ask`: paragraph | article
CHUNK_STRATEGY=paragraph
# Retrieval used by `ask`: dense | hybrid
RETRIEVAL_MODE=dense
# Number of chunks retrieved per query.
TOP_K=5

# ---------------------------------------------------------------------------
# LLM backend for answer generation: openai | ollama
# ---------------------------------------------------------------------------
LLM_BACKEND=openai

# --- openai backend (any OpenAI-compatible API: OpenAI, Groq, OpenRouter, ...)
OPENAI_API_KEY=your-api-key-here
# Optional: override for non-OpenAI providers, e.g.
#   https://api.groq.com/openai/v1   or   https://openrouter.ai/api/v1
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# --- ollama backend (fully local, no API key required)
OLLAMA_MODEL=llama3.2:3b
# Optional: override if Ollama runs on a non-default host.
OLLAMA_HOST=
